<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Nur fuer den Moment zwischen Prozessstart und erstem Compose-Frame.
         Farbe entspricht `paper` aus ui/theme/Color.kt. -->
    <style name="Theme.GzgTracker.Starting" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
