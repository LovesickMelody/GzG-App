<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Bonfotos liegen app-intern unter files/receipts, CSV-Exporte unter cache/export.
         Der FileProvider gibt sie nur fuer das Share-Sheet frei. -->
    <files-path
        name="receipts"
        path="receipts/" />
    <cache-path
        name="export"
        path="export/" />
    <!-- Frisch aufgenommene Fotos: Die Kamera-App schreibt hierher, danach
         wandern sie verkleinert nach files/receipts und werden hier geloescht. -->
    <cache-path
        name="kamera"
        path="kamera/" />
</paths>
